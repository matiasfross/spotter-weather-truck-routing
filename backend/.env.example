# Django Configuration
DJANGO_SECRET_KEY=spotter-weather-truck-routing-secret-key-prod-dev
DEBUG=True

# OpenRouteService API Key (Optional - Commercial Heavy Goods Vehicle 'driving-hgv' routing)
# Get a free key at: https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# Mapbox Access Token (Optional - Alternative routing & geocoding)
# Get a free token at: https://account.mapbox.com/
MAPBOX_ACCESS_TOKEN=

# OpenWeatherMap API Key (Optional - Live Doppler Radar Layer)
# Managed SECURELY on the server; NEVER exposed to the frontend browser.
# Get a free key at: https://home.openweathermap.org/users/sign_up
OPENWEATHER_API_KEY=
