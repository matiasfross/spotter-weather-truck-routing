# Backend API Base URL
VITE_API_URL=http://localhost:8000/api

# Mapbox Public Access Token (Optional - High Definition Vector Dark & Satellite maps)
# NOTE: In production, configure "URL Restrictions" on your token at https://account.mapbox.com/
# to restrict usage strictly to your authorized production domain (e.g. https://your-truck-app.com/*).
VITE_MAPBOX_TOKEN=
